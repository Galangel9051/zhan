[Unit]
Description=栈长 · Compose 部署管理台
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# 创建专用账户并授予受管项目和 Docker 所需权限；不要直接复制未知账户配置。
User=zhan
Group=zhan
SupplementaryGroups=docker
WorkingDirectory=/opt/zhan
ExecStart=/opt/zhan/zhan --config /opt/zhan/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Environment=GIT_TERMINAL_PROMPT=0
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
